{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Package SCORM Simulation",
      "detail": "Zips a simulation folder and injects imsmanifest.xml + scorm-wrapper.js",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/package-sim.js",
        "${input:simFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "simFolder",
      "type": "promptString",
      "description": "Simulation folder to package (e.g. sim-projectile-motion)",
      "default": "sim-projectile-motion"
    }
  ]
}
