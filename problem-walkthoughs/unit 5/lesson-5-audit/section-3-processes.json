    "math": [
      "\\begin{aligned}\\Delta\\lambda=\\lambda_{\\mathrm{obs}}-\\lambda_0=505-500=+5\\,\\mathrm{nm}\\end{aligned}"
    ],
    "title": "Compare observed and rest wavelengths"
  },
  {
    "images": 1,
    "math": [
      "\\begin{aligned}z=\\frac{\\lambda_{\\mathrm{obs}}-\\lambda_0}{\\lambda_0}=\\frac{5}{500}=+0.010\\end{aligned}"
    ],
    "title": "Calculate the fractional shift"
  },
  {
    "images": 1,
    "math": [
      "\\begin{aligned}v_r\\approx cz=(300{,}000\\,\\mathrm{km/s})(0.010)=+3{,}000\\,\\mathrm{km/s}\\end{aligned}"
    ],
    "title": "Estimate radial speed"
  },
  {
