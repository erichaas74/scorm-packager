    "images": 1,
    "math": [
      "\\begin{aligned}\\Delta t=0.10\\,\\mu\\mathrm{s}=0.10\\times10^{-6}\\,\\mathrm{s}=1.0\\times10^{-7}\\,\\mathrm{s}\\end{aligned}"
    ],
    "title": "Convert microseconds to seconds"
  },
  {
    "images": 1,
    "math": [
      "\\begin{aligned}|\\Delta r|=c|\\Delta t|=(3.00\\times10^8)(1.0\\times10^{-7})=30\\,\\mathrm{m}\\end{aligned}"
    ],
    "title": "Calculate the range error"
  },
  {
    "images": 1,
    "math": [
      "\\begin{aligned}|\\Delta t|<\\frac{10\\,\\mathrm{m}}{3.00\\times10^8\\,\\mathrm{m/s}}=3.33\\times10^{-8}\\,\\mathrm{s}=0.0333\\,\\mu\\mathrm{s}\\end{aligned}"
    ],
    "title": "Solve for the allowed timing error"
  },
