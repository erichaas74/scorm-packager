<?xml version="1.0" encoding="UTF-8"?>
<!--
  imsmanifest.xml  –  Generic SCORM 1.2 manifest template
  ─────────────────────────────────────────────────────────
  Replace the placeholder values marked with ALL_CAPS before
  uploading to an LMS, or let package-sim.js inject this file as-is
  for a quick test run.

  Key fields to customise per simulation:
    • manifest @identifier   – unique reverse-DNS style ID
    • <title>                – human-readable course title
    • <adlcp:masteryscore>  – passing threshold (0–100)
    • resource @href         – entry-point HTML file
-->
<manifest
  identifier="com.yourorg.SIMULATION_ID"
  version="1.0"
  xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
  xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="
    http://www.imsproject.org/xsd/imscp_rootv1p1p2 imscp_rootv1p1p2.xsd
    http://www.imsglobal.org/xsd/imsmd_rootv1p2p1  imsmd_rootv1p2p1.xsd
    http://www.adlnet.org/xsd/adlcp_rootv1p2        adlcp_rootv1p2.xsd">

  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>

  <organizations default="ORG-001">
    <organization identifier="ORG-001">
      <title>Physics Simulation</title>
      <item identifier="ITEM-001" identifierref="RES-001">
        <title>Simulation</title>
        <!-- Score the learner must reach to be marked "passed" (0–100) -->
        <adlcp:masteryscore>80</adlcp:masteryscore>
        <!-- Maximum time allowed in HH:MM:SS (remove if not needed) -->
        <!-- <adlcp:timelimitaction>continue,no message</adlcp:timelimitaction> -->
      </item>
    </organization>
  </organizations>

  <resources>
    <!--
      adlcp:scormtype="sco"  → this resource communicates with the LMS.
      Change href to match your actual entry-point file if it differs
      from index.html.
    -->
    <resource
      identifier="RES-001"
      type="webcontent"
      adlcp:scormtype="sco"
      href="index.html">
      <file href="index.html"/>
      <file href="scorm-wrapper.js"/>
    </resource>
  </resources>

</manifest>
