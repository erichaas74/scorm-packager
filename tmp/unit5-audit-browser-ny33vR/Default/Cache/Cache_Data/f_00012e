<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interference: Adding Two Pulses</title>
  <style>
    :root {
      --navy: #153456;
      --blue: #285f9f;
      --blue-dark: #174b86;
      --blue-soft: #e8f2fd;
      --orange: #e56b24;
      --orange-soft: #fff1e8;
      --ink: #132238;
      --muted: #52657b;
      --line: #c8d7e8;
      --surface: #ffffff;
      --stage: #f4f9ff;
      --success-soft: #e8f7ed;
    }

    * { box-sizing: border-box; }

    html,
    body {
      margin: 0;
      background: transparent;
      color: var(--ink);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    button { font: inherit; touch-action: manipulation; min-height: 44px; }

    .wif-app {
      width: min(100%, 1080px);
      margin: 0 auto;
      border: 5px solid #285f9f;
      border-radius: 24px;
      overflow: hidden;
      background: var(--surface);
      box-shadow: 0 18px 48px rgba(21, 52, 86, 0.14);
    }

    .wif-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 18px 22px 15px;
      border-bottom: 1px solid var(--line);
      background: linear-gradient(115deg, #fff 0%, #eef7ff 100%);
    }

    .wif-kicker {
      margin: 0 0 3px;
      color: var(--blue);
      font-size: 0.73rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      color: var(--navy);
      font-size: clamp(1.3rem, 3.9vw, 1.95rem);
      letter-spacing: -0.03em;
      line-height: 1.08;
    }

    .wif-reset {
      flex: 0 0 auto;
      min-height: 40px;
      padding: 8px 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--blue-dark);
      font-weight: 750;
      cursor: pointer;
    }

    .wif-main { padding: 18px; }

    .wif-stage {
      position: relative;
      border: 1px solid #adc6df;
      border-radius: 18px;
      overflow: hidden;
      background: var(--stage);
    }

    .wif-stage-top {
      position: absolute;
      z-index: 2;
      inset: 12px 13px auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      pointer-events: none;
    }

    .wif-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 30px;
      padding: 5px 11px;
      border: 1px solid rgba(40, 95, 159, 0.23);
      border-radius: 999px;
      background: rgba(255,255,255,0.93);
      color: var(--navy);
      font-size: 0.78rem;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(21, 52, 86, 0.08);
    }

    canvas {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1000 / 340;
    }

    .wif-prompt-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin-top: 14px;
      padding: 15px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #fff;
    }

    .wif-step-label {
      margin: 0 0 5px;
      color: var(--blue);
      font-size: 0.72rem;
      font-weight: 850;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .wif-question { margin: 0; color: var(--navy); font-size: 1.02rem; font-weight: 800; line-height: 1.35; }

    .wif-choices {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(158px, 1fr));
      gap: 10px;
      margin-top: 11px;
    }

    .wif-choice {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      padding: 10px 10px 11px;
      border: 1px solid #9eb4cb;
      border-radius: 13px;
      background: #fff;
      color: var(--ink);
      font-weight: 750;
      text-align: center;
      cursor: pointer;
    }

    .wif-choice svg {
      display: block;
      width: 100%;
      height: auto;
      border-radius: 9px;
      background: var(--stage);
    }

    .wif-choice-text { font-size: 0.86rem; line-height: 1.3; }

    .wif-choice:hover:not(:disabled) { border-color: var(--blue); background: var(--blue-soft); }
    .wif-choice:hover:not(:disabled) svg { background: #fff; }

    .wif-feedback {
      margin: 10px 0 0;
      padding: 10px 12px;
      border-radius: 11px;
      background: var(--success-soft);
      color: #14532d;
      font-size: 0.88rem;
      font-weight: 650;
      line-height: 1.42;
    }

    .wif-feedback[data-tone="note"] { background: var(--orange-soft); color: #7c2d12; }

    .wif-primary {
      width: 100%;
      margin-top: 11px;
      padding: 10px 14px;
      border: 0;
      border-radius: 11px;
      background: var(--blue);
      color: #fff;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 5px 13px rgba(40,95,159,0.22);
    }

    .wif-primary:hover { background: var(--blue-dark); }
    .wif-primary:disabled, .wif-choice:disabled { cursor: not-allowed; opacity: 0.58; }

    [hidden] { display: none !important; }

    :focus-visible { outline: 3px solid #e56b24; outline-offset: 3px; }

    .wif-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (max-width: 760px) {
      .wif-main { padding: 12px; }
    }

    @media (max-width: 480px) {
      .wif-header { align-items: flex-start; padding: 15px 14px 13px; }
    }
  </style>
</head>
<body>
  <main class="wif-app" id="interference-app">
    <header class="wif-header">
      <div>
        <p class="wif-kicker">Unit 5 · Lesson 1 · Part 3</p>
        <h1>Interference: Adding Two Pulses</h1>
      </div>
      <button class="wif-reset" id="reset-button" type="button">Reset</button>
    </header>

    <div class="wif-main">
      <section class="wif-stage">
        <div class="wif-stage-top" aria-hidden="true">
          <span class="wif-badge" id="setup-badge">Two pulses approaching</span>
          <span class="wif-badge" id="motion-badge">Ready</span>
        </div>
        <canvas id="rope-canvas" role="img" aria-labelledby="canvas-label"></canvas>
        <p class="wif-sr-only" id="canvas-label">Two pulses repeatedly travel toward a mystery box at the middle marker, stopping just before they overlap.</p>
      </section>

      <section class="wif-prompt-panel" aria-labelledby="prompt-question">
        <p class="wif-step-label" id="step-label">Predict first</p>
        <p class="wif-question" id="prompt-question">At the instant they fully overlap, how high is the rope?</p>
        <div class="wif-choices" id="choices"></div>
        <p class="wif-feedback" id="feedback" role="status" aria-live="polite" hidden></p>
        <button class="wif-primary" id="main-button" type="button" hidden>Next scenario</button>
      </section>
    </div>

    <p class="wif-sr-only" id="status" role="status" aria-live="polite">Interference simulation ready.</p>

    <script>
      (() => {
        'use strict';

        const W = 1000;
        const H = 340;
        const BASE = 186;
        const MARK = 500;
        const START_A = 120;
        const START_B = 880;
        const V = 300;                 // px per second
        const PX_PER_CM = 18;
        const PULSE_W = 62;
        const MEET = (MARK - START_A) / V;
        const PREDICT_GAP = 112;
        const PREDICT_STOP = (MARK - PREDICT_GAP - START_A) / V;
        const PREDICT_PAUSE = 1.35;

        const scenarios = [
          {
            title: 'Two crests',
            text: 'A 3 cm crest travels right; an identical 3 cm crest travels left.',
            a: 3, b: 3, freeze: MEET,
            question: 'At the instant they fully overlap, how high is the rope?',
            options: [
              { text: '6 cm — the two heights add', correct: true, pulses: [{ a: 6, x: 0.5 }] },
              { text: '3 cm — the taller one wins', correct: false, pulses: [{ a: 3, x: 0.5 }] },
              { text: '0 cm — they cancel', correct: false, pulses: [] }
            ],
            after: 'Both continue',
            explanation: 'The rope reaches 6 cm. Overlapping displacements add, so two crests build one taller crest.'
          },
          {
            title: 'Crest meets equal trough',
            text: 'A 3 cm crest travels right; a 3 cm trough travels left.',
            a: 3, b: -3, freeze: MEET,
            question: 'At full overlap, what does the rope look like?',
            options: [
              { text: 'Flat for an instant', correct: true, pulses: [] },
              { text: 'A 6 cm crest', correct: false, pulses: [{ a: 6, x: 0.5 }] },
              { text: 'A 3 cm crest', correct: false, pulses: [{ a: 3, x: 0.5 }] }
            ],
            after: 'Both continue',
            explanation: 'The rope goes flat. Adding +3 cm and −3 cm at every point leaves zero displacement.'
          },
          {
            title: 'After the cancellation',
            text: 'The same crest and trough, played past the flat moment.',
            a: 3, b: -3, freeze: MEET + 1.25,
            question: 'After that flat moment, what do the two pulses do?',
            options: [
              {
                text: 'Both continue on, unchanged',
                correct: true,
                animation: 'continue',
                pulses: [{ a: -3, x: 0.26, dir: -1 }, { a: 3, x: 0.74, dir: 1 }]
              },
              { text: 'They cancel out and vanish', correct: false, animation: 'vanish', pulses: [] },
              {
                text: 'They bounce back the way they came',
                correct: false,
                animation: 'bounce',
                pulses: [{ a: 3, x: 0.26, dir: -1 }, { a: -3, x: 0.74, dir: 1 }]
              }
            ],
            after: 'Both continue',
            explanation: 'Both keep going unchanged. The cancellation was in the shape only; each pulse still carries its energy.'
          },
          {
            title: 'Unequal pulses',
            text: 'A 3 cm crest travels right; a 1.5 cm trough travels left.',
            a: 3, b: -1.5, freeze: MEET,
            question: 'At full overlap, what is the rope displacement at the marker?',
            options: [
              { text: '+1.5 cm', correct: true, pulses: [{ a: 1.5, x: 0.5 }] },
              { text: '+4.5 cm', correct: false, pulses: [{ a: 4.5, x: 0.5 }] },
              { text: '0 cm', correct: false, pulses: [] }
            ],
            after: 'Both continue',
            explanation: 'The rope sits at +1.5 cm. Partial cancellation still follows the same rule: add the displacements.'
          },
          {
            title: 'Superposition builder',
            text: 'At the marker, pulse A reads −3 cm and pulse B reads +1 cm.',
            a: -3, b: 1, freeze: MEET,
            question: 'What does the rope read at the marker?',
            options: [
              { text: '−2 cm', correct: true, pulses: [{ a: -2, x: 0.5 }] },
              { text: '+2 cm', correct: false, pulses: [{ a: 2, x: 0.5 }] },
              { text: '−4 cm', correct: false, pulses: [{ a: -4, x: 0.5 }] },
              { text: '0 cm', correct: false, pulses: [] }
            ],
            after: 'Both continue',
            explanation: 'The rope reads −2 cm. Superposition is a signed sum: −3 cm plus +1 cm, so the larger downward pulse wins.'
          }
        ];

        const el = {
          canvas: document.getElementById('rope-canvas'),
          setupBadge: document.getElementById('setup-badge'),
          motionBadge: document.getElementById('motion-badge'),
          stepLabel: document.getElementById('step-label'),
          question: document.getElementById('prompt-question'),
          choices: document.getElementById('choices'),
          feedback: document.getElementById('feedback'),
          main: document.getElementById('main-button'),
          reset: document.getElementById('reset-button'),
          status: document.getElementById('status')
        };

        const ctx = el.canvas.getContext('2d');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let index = 0;
        let state = 'predict';        // predict → reveal → explain
        let simTime = 0;
        let stopAt = 0;
        let running = false;
        let previousFrame = 0;
        let predictPauseRemaining = 0;
        let pendingCorrect = false;
        let completionSent = false;

        function scenario() { return scenarios[index]; }

        function isCancellationPart() { return index === 2; }

        function gauss(x, center) {
          const u = (x - center) / PULSE_W;
          return Math.exp(-u * u);
        }

        function componentA(x) {
          return scenario().a * PX_PER_CM * gauss(x, START_A + V * simTime);
        }

        function componentB(x) {
          return scenario().b * PX_PER_CM * gauss(x, START_B - V * simTime);
        }

        function fitCanvas() {
          const ratio = window.devicePixelRatio || 1;
          const cssWidth = el.canvas.clientWidth || W;
          const cssHeight = cssWidth * (H / W);
          el.canvas.width = Math.round(cssWidth * ratio);
          el.canvas.height = Math.round(cssHeight * ratio);
          ctx.setTransform((cssWidth * ratio) / W, 0, 0, (cssHeight * ratio) / H, 0, 0);
        }

        function drawCurve(fn, color, width, dashed, dashOffset = 0) {
          ctx.save();
          if (dashed) {
            ctx.setLineDash([9, 9]);
            ctx.lineDashOffset = dashOffset;
          }
          ctx.beginPath();
          for (let x = 20; x <= W - 20; x += 3) {
            const y = BASE - fn(x);
            if (x === 20) ctx.moveTo(x, y); else ctx.lineTo(x, y);
          }
          ctx.strokeStyle = color;
          ctx.lineWidth = width;
          ctx.lineJoin = 'round';
          ctx.lineCap = 'round';
          ctx.stroke();
          ctx.restore();
        }

        function formatCm(value) {
          const shown = Math.abs(value) < 0.05 ? 0 : value;
          return `${shown >= 0 ? '+' : '−'}${Math.abs(shown).toFixed(1)} cm`;
        }

        function drawTag(text, x, y, border, ink) {
          ctx.save();
          ctx.font = '850 15px system-ui, sans-serif';
          const w = ctx.measureText(text).width + 20;
          const h = 27;
          const left = Math.min(Math.max(x - w / 2, 24), W - 24 - w);
          const top = y - h / 2;
          const r = 9;
          ctx.beginPath();
          ctx.moveTo(left + r, top);
          ctx.arcTo(left + w, top, left + w, top + h, r);
          ctx.arcTo(left + w, top + h, left, top + h, r);
          ctx.arcTo(left, top + h, left, top, r);
          ctx.arcTo(left, top, left + w, top, r);
          ctx.closePath();
          ctx.fillStyle = 'rgba(255, 255, 255, 0.94)';
          ctx.fill();
          ctx.strokeStyle = border;
          ctx.lineWidth = 1.7;
          ctx.stroke();
          ctx.fillStyle = ink;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(text, left + w / 2, y + 1);
          ctx.restore();
        }

        // Amplitude labels ride on their own pulse; they nudge apart while the pulses overlap.
        function drawAmplitudeTags() {
          const s = scenario();
          const xA = START_A + V * simTime;
          const xB = START_B - V * simTime;
          const gap = Math.abs(xA - xB);
          const spread = gap < 170 ? (170 - gap) / 2 : 0;
          const yA = BASE - s.a * PX_PER_CM + (s.a >= 0 ? -25 : 25);
          const yB = BASE - s.b * PX_PER_CM + (s.b >= 0 ? -25 : 25);
          drawTag(`A ${formatCm(s.a)}`, xA - spread, yA, '#285f9f', '#174b86');
          drawTag(`B ${formatCm(s.b)}`, xB + spread, yB, '#7a5db5', '#5b3f96');
        }

        function drawAmplitudeGuide(x, amplitude, color) {
          const peakY = BASE - amplitude * PX_PER_CM;
          ctx.save();
          ctx.setLineDash([3, 6]);
          ctx.strokeStyle = color;
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(x, BASE);
          ctx.lineTo(x, peakY);
          ctx.stroke();

          ctx.setLineDash([]);
          ctx.lineWidth = 2.5;
          ctx.beginPath();
          ctx.moveTo(x - 9, peakY);
          ctx.lineTo(x + 9, peakY);
          ctx.moveTo(x - 7, BASE);
          ctx.lineTo(x + 7, BASE);
          ctx.stroke();
          ctx.restore();
        }

        function drawAmplitudeGuides() {
          const s = scenario();
          let xA = START_A + V * simTime;
          let xB = START_B - V * simTime;
          if (Math.abs(xA - xB) < 18) {
            xA -= 5;
            xB += 5;
          }
          drawAmplitudeGuide(xA, s.a, 'rgba(40,95,159,0.88)');
          drawAmplitudeGuide(xB, s.b, 'rgba(122,93,181,0.88)');
        }

        function drawMysteryBox() {
          const size = 180;
          const left = MARK - size / 2;
          const top = BASE - size / 2;

          ctx.save();
          ctx.shadowColor = 'rgba(21, 52, 86, 0.18)';
          ctx.shadowBlur = 18;
          ctx.shadowOffsetY = 7;
          ctx.fillStyle = '#fff8f2';
          ctx.strokeStyle = '#e56b24';
          ctx.lineWidth = 6;
          ctx.beginPath();
          ctx.moveTo(left + 18, top);
          ctx.arcTo(left + size, top, left + size, top + size, 18);
          ctx.arcTo(left + size, top + size, left, top + size, 18);
          ctx.arcTo(left, top + size, left, top, 18);
          ctx.arcTo(left, top, left + size, top, 18);
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
          ctx.restore();

          ctx.save();
          ctx.fillStyle = '#9a4a10';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.font = '850 14px system-ui, sans-serif';
          ctx.fillText('MYSTERY', MARK, top + 31);
          ctx.fillStyle = '#153456';
          ctx.font = '900 82px system-ui, sans-serif';
          ctx.fillText('?', MARK, BASE + 16);
          ctx.restore();
        }

        function draw() {
          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = '#f4f9ff';
          ctx.fillRect(0, 0, W, H);

          // equilibrium line
          ctx.save();
          ctx.setLineDash([7, 9]);
          ctx.strokeStyle = '#b9c8d8';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(20, BASE);
          ctx.lineTo(W - 20, BASE);
          ctx.stroke();
          ctx.restore();

          // marker line
          ctx.save();
          ctx.setLineDash([5, 7]);
          ctx.strokeStyle = '#8ca7c2';
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(MARK, 44);
          ctx.lineTo(MARK, H - 46);
          ctx.stroke();
          ctx.restore();
          ctx.fillStyle = '#52657b';
          ctx.font = '800 14px system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText('MARKER', MARK, H - 26);

          drawAmplitudeGuides();
          drawCurve(componentA, 'rgba(40,95,159,0.7)', 4, true, 0);
          drawCurve(componentB, 'rgba(122,93,181,0.7)', 4, true, 9);
          drawCurve((x) => componentA(x) + componentB(x), '#e56b24', 8, false);

          // marker dot on the rope
          const sum = componentA(MARK) + componentB(MARK);
          ctx.beginPath();
          ctx.arc(MARK, BASE - sum, 9, 0, Math.PI * 2);
          ctx.fillStyle = '#153456';
          ctx.fill();

          // travel direction labels
          ctx.font = '800 15px system-ui, sans-serif';
          ctx.fillStyle = '#285f9f';
          ctx.textAlign = 'left';
          ctx.fillText('pulse A →', 32, 70);
          ctx.fillStyle = '#7a5db5';
          ctx.textAlign = 'right';
          ctx.fillText('← pulse B', W - 32, 70);
          ctx.textAlign = 'left';

          // The prediction box conceals the marker so students must infer the overlap.
          if (state === 'predict' && !isCancellationPart()) {
            drawMysteryBox();
          } else if (state !== 'predict') {
            drawTag(`rope at marker: ${formatCm(sum / PX_PER_CM)}`, MARK, H - 62, '#e0a878', '#9a4a10');
          }

          drawAmplitudeTags();
        }

        function shuffle(items) {
          const result = items.slice();
          for (let i = result.length - 1; i > 0; i -= 1) {
            const j = Math.floor(Math.random() * (i + 1));
            [result[i], result[j]] = [result[j], result[i]];
          }
          return result;
        }

        // Answer thumbnails: same gaussian rope the stage draws, shrunk to a 200×92 box.
        const SVG_NS = 'http://www.w3.org/2000/svg';
        const TW = 200;
        const TH = 92;
        const TBASE = 54;
        const T_PER_CM = 5.4;
        const T_PULSE = 24;

        function svgNode(name, attrs) {
          const node = document.createElementNS(SVG_NS, name);
          Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, String(value)));
          return node;
        }

        function thumbHeight(pulses, x) {
          return pulses.reduce((total, p) => {
            const u = (x - p.x * TW) / T_PULSE;
            return total - p.a * T_PER_CM * Math.exp(-u * u);
          }, TBASE);
        }

        function thumbPath(pulses) {
          let d = '';
          for (let x = 6; x <= TW - 6; x += 4) {
            d += `${d ? 'L' : 'M'}${x} ${thumbHeight(pulses, x).toFixed(1)}`;
          }
          return d;
        }

        function collisionFrames(outcome) {
          const approaching = [
            [{ a: 3, x: 0.22 }, { a: -3, x: 0.78 }],
            [{ a: 3, x: 0.34 }, { a: -3, x: 0.66 }],
            [{ a: 3, x: 0.43 }, { a: -3, x: 0.57 }],
            [{ a: 3, x: 0.5 }, { a: -3, x: 0.5 }]
          ];

          if (outcome === 'continue') {
            return approaching.concat([
              [{ a: -3, x: 0.43 }, { a: 3, x: 0.57 }],
              [{ a: -3, x: 0.34 }, { a: 3, x: 0.66 }],
              [{ a: -3, x: 0.22 }, { a: 3, x: 0.78 }]
            ]);
          }
          if (outcome === 'bounce') {
            return approaching.concat([
              [{ a: 3, x: 0.43 }, { a: -3, x: 0.57 }],
              [{ a: 3, x: 0.34 }, { a: -3, x: 0.66 }],
              [{ a: 3, x: 0.22 }, { a: -3, x: 0.78 }]
            ]);
          }
          return approaching.concat([[], [], []]);
        }

        function predictionFrames(resultPulses) {
          const s = scenario();
          return [
            [{ a: s.a, x: 0.2 }, { a: s.b, x: 0.8 }],
            [{ a: s.a, x: 0.32 }, { a: s.b, x: 0.68 }],
            [{ a: s.a, x: 0.41 }, { a: s.b, x: 0.59 }],
            [{ a: s.a, x: 0.46 }, { a: s.b, x: 0.54 }],
            resultPulses,
            resultPulses,
            resultPulses
          ];
        }

        function componentAnimationFrames(animation) {
          let aCenters = [0.2, 0.32, 0.41, 0.46, 0.5, 0.5, 0.5];
          let bCenters = [0.8, 0.68, 0.59, 0.54, 0.5, 0.5, 0.5];

          if (animation === 'continue') {
            aCenters = [0.22, 0.34, 0.43, 0.5, 0.57, 0.66, 0.78];
            bCenters = [0.78, 0.66, 0.57, 0.5, 0.43, 0.34, 0.22];
          } else if (animation === 'bounce') {
            aCenters = [0.22, 0.34, 0.43, 0.5, 0.43, 0.34, 0.22];
            bCenters = [0.78, 0.66, 0.57, 0.5, 0.57, 0.66, 0.78];
          }

          const aFrames = aCenters.map((x, i) => animation === 'vanish' && i > 3 ? [] : [{ a: scenario().a, x }]);
          const bFrames = bCenters.map((x, i) => animation === 'vanish' && i > 3 ? [] : [{ a: scenario().b, x }]);
          return { aFrames, bFrames };
        }

        function addAnimatedComponent(svg, frames, color, dashOffset) {
          const loopFrames = [frames[0]].concat(frames, [frames[frames.length - 1], frames[frames.length - 1]]);
          const paths = loopFrames.map(thumbPath);
          const path = svgNode('path', {
            d: paths[0], fill: 'none', stroke: color,
            'stroke-width': 2.5, 'stroke-dasharray': '6 5',
            'stroke-dashoffset': dashOffset, 'stroke-linecap': 'round', 'stroke-linejoin': 'round'
          });
          path.append(svgNode('animate', {
            attributeName: 'd', values: paths.join(';'), dur: '4.2s',
            repeatCount: 'indefinite', calcMode: 'linear'
          }));
          svg.append(path);
        }

        function buildThumb(option) {
          const { pulses, animation } = option;
          const frames = animation ? collisionFrames(animation) : predictionFrames(pulses);
          const loopFrames = [frames[0]].concat(frames, [frames[frames.length - 1], frames[frames.length - 1]]);
          const svg = svgNode('svg', { viewBox: `0 0 ${TW} ${TH}`, 'aria-hidden': 'true', focusable: 'false' });
          svg.append(svgNode('line', {
            x1: 6, y1: TBASE, x2: TW - 6, y2: TBASE,
            stroke: '#b9c8d8', 'stroke-width': 1.6, 'stroke-dasharray': '5 6'
          }));
          svg.append(svgNode('line', {
            x1: TW / 2, y1: 9, x2: TW / 2, y2: TH - 9,
            stroke: '#8ca7c2', 'stroke-width': 2, 'stroke-dasharray': '3 5'
          }));
          if (!reduceMotion) {
            const components = componentAnimationFrames(animation);
            addAnimatedComponent(svg, components.aFrames, 'rgba(40,95,159,0.72)', 0);
            addAnimatedComponent(svg, components.bFrames, 'rgba(122,93,181,0.72)', 5);
          }
          const rope = svgNode('path', {
            d: thumbPath(pulses), fill: 'none', stroke: '#e56b24',
            'stroke-width': 5, 'stroke-linecap': 'round', 'stroke-linejoin': 'round'
          });
          if (!reduceMotion) {
            const paths = loopFrames.map(thumbPath);
            rope.setAttribute('d', paths[0]);
            rope.append(svgNode('animate', {
              attributeName: 'd',
              values: paths.join(';'),
              dur: '4.2s',
              repeatCount: 'indefinite',
              calcMode: 'linear'
            }));
          }
          svg.append(rope);
          const markerDot = svgNode('circle', {
            cx: TW / 2, cy: thumbHeight(pulses, TW / 2).toFixed(1), r: 5, fill: '#153456'
          });
          if (!reduceMotion) {
            const markerValues = loopFrames.map((frame) => thumbHeight(frame, TW / 2).toFixed(1));
            markerDot.setAttribute('cy', markerValues[0]);
            markerDot.append(svgNode('animate', {
              attributeName: 'cy',
              values: markerValues.join(';'),
              dur: '4.2s',
              repeatCount: 'indefinite',
              calcMode: 'linear'
            }));
          }
          svg.append(markerDot);

          // travel arrows, for options that answer "what happens next" rather than "what shape"
          pulses.filter((p) => p.dir).forEach((p) => {
            const px = p.x * TW;
            const py = TBASE - p.a * T_PER_CM + (p.a >= 0 ? -11 : 11);
            svg.append(svgNode('path', {
              d: `M${px - p.dir * 12} ${py}L${px + p.dir * 6} ${py}M${px + p.dir * 12} ${py}L${px + p.dir * 4} ${py - 4}M${px + p.dir * 12} ${py}L${px + p.dir * 4} ${py + 4}`,
              fill: 'none', stroke: '#285f9f', 'stroke-width': 2.4,
              'stroke-linecap': 'round', 'stroke-linejoin': 'round'
            }));
          });
          return svg;
        }

        function renderChoices(options, handler) {
          el.choices.replaceChildren();
          shuffle(options).forEach((option) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'wif-choice';
            const caption = document.createElement('span');
            caption.className = 'wif-choice-text';
            caption.textContent = option.text;
            button.append(buildThumb(option), caption);
            button.addEventListener('click', () => handler(option), { once: true });
            el.choices.append(button);
          });
        }

        function lockChoices() {
          el.choices.querySelectorAll('button').forEach((button) => { button.disabled = true; });
        }

        function loadScenario() {
          const s = scenario();
          state = 'predict';
          simTime = 0;
          running = false;
          predictPauseRemaining = 0;
          el.setupBadge.textContent = s.title;
          el.motionBadge.textContent = reduceMotion && !isCancellationPart()
            ? 'Approaching marker'
            : 'Moving toward each other';
          el.stepLabel.textContent = `Predict · scenario ${index + 1} of ${scenarios.length}`;
          el.question.textContent = s.question;
          el.feedback.hidden = true;
          el.main.hidden = true;
          el.choices.hidden = false;
          renderChoices(s.options, choose);
          draw();
          el.status.textContent = `${s.title}. ${s.text} Choose a prediction.`;
        }

        function choose(option) {
          if (state !== 'predict') return;
          lockChoices();
          el.choices.hidden = true;
          state = 'reveal';
          pendingCorrect = option.correct;
          el.stepLabel.textContent = 'Watch them overlap';
          el.question.textContent = 'Dashed curves are the two pulses. Orange is the rope.';
          simTime = 0;
          stopAt = scenario().freeze;
          running = true;
          el.motionBadge.textContent = 'Playing';
          el.status.textContent = 'Reveal running.';
          if (reduceMotion) {
            simTime = stopAt;
            running = false;
            finishReveal();
          }
        }

        function finishReveal() {
          const s = scenario();
          running = false;
          state = 'explain';
          draw();
          el.motionBadge.textContent = `Frozen · ${s.after}`;
          el.question.textContent = 'What the rope did:';
          el.feedback.textContent = s.explanation;
          el.feedback.dataset.tone = pendingCorrect ? 'success' : 'note';
          el.feedback.hidden = false;
          el.main.textContent = index === scenarios.length - 1 ? 'Finish' : 'Next scenario';
          el.main.hidden = false;
          el.stepLabel.textContent = 'Evidence';
          el.status.textContent = s.explanation;
        }

        function handleMain() {
          if (state === 'complete') { index = 0; loadScenario(); return; }
          if (index < scenarios.length - 1) {
            index += 1;
            loadScenario();
            return;
          }
          state = 'complete';
          el.stepLabel.textContent = 'All five overlaps done';
          el.question.textContent = 'Waves add, then move on.';
          el.feedback.textContent = 'Overlapping pulses add displacement by displacement. Afterwards each pulse continues exactly as before.';
          el.feedback.dataset.tone = 'success';
          el.feedback.hidden = false;
          el.main.textContent = 'Start over';
          sendCompletion();
        }

        function sendCompletion() {
          if (completionSent) return;
          completionSent = true;
          window.parent.postMessage({ type: 'complete' }, '*');
          el.status.textContent = 'Interference walkthrough complete.';
        }

        function animate(now) {
          const delta = previousFrame ? Math.min((now - previousFrame) / 1000, 0.05) : 0;
          previousFrame = now;
          if (running) {
            simTime += delta;
            if (simTime >= stopAt) {
              simTime = stopAt;
              running = false;
              finishReveal();
            }
          } else if (state === 'predict' && !reduceMotion) {
            if (predictPauseRemaining > 0) {
              predictPauseRemaining -= delta;
              if (predictPauseRemaining <= 0) {
                simTime = 0;
                el.motionBadge.textContent = 'Moving toward each other';
              }
            } else {
              simTime += delta;
              const predictionStop = isCancellationPart() ? MEET : PREDICT_STOP;
              if (simTime >= predictionStop) {
                simTime = predictionStop;
                if (isCancellationPart()) {
                  el.motionBadge.textContent = 'Canceled at marker';
                } else {
                  predictPauseRemaining = PREDICT_PAUSE;
                  el.motionBadge.textContent = 'Pause before overlap';
                }
              }
            }
          } else if (state === 'predict') {
            simTime = isCancellationPart() ? MEET : PREDICT_STOP;
            if (isCancellationPart()) el.motionBadge.textContent = 'Canceled at marker';
          }
          draw();
          requestAnimationFrame(animate);
        }

        function reset() {
          index = 0;
          completionSent = false;
          loadScenario();
        }

        el.main.addEventListener('click', handleMain);
        el.reset.addEventListener('click', reset);
        window.addEventListener('resize', () => { fitCanvas(); draw(); });
        document.addEventListener('visibilitychange', () => { if (document.hidden) previousFrame = 0; });

        fitCanvas();
        reset();
        requestAnimationFrame(animate);
      })();
    </script>
  </main>
</body>
</html>
