<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boundary Behavior: Reflect and Transmit</title>
  <style>
    :root {
      --navy: #153456;
      --blue: #285f9f;
      --blue-dark: #174b86;
      --blue-soft: #e8f2fd;
      --cyan: #36a6c9;
      --orange: #e56b24;
      --orange-soft: #fff1e8;
      --ink: #132238;
      --muted: #52657b;
      --line: #c8d7e8;
      --surface: #ffffff;
      --stage: #f4f9ff;
      --success-soft: #e8f7ed;
    }

    * { box-sizing: border-box; }

    html,
    body {
      margin: 0;
      background: transparent;
      color: var(--ink);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }

    button { font: inherit; touch-action: manipulation; min-height: 44px; }

    .wbb-app {
      width: min(100%, 1080px);
      margin: 0 auto;
      border: 5px solid #285f9f;
      border-radius: 24px;
      overflow: hidden;
      background: var(--surface);
      box-shadow: 0 18px 48px rgba(21, 52, 86, 0.14);
    }

    .wbb-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 18px 22px 15px;
      border-bottom: 1px solid var(--line);
      background: linear-gradient(115deg, #fff 0%, #eef7ff 100%);
    }

    .wbb-kicker {
      margin: 0 0 3px;
      color: var(--blue);
      font-size: 0.73rem;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      color: var(--navy);
      font-size: clamp(1.3rem, 3.9vw, 1.95rem);
      letter-spacing: -0.03em;
      line-height: 1.08;
    }

    .wbb-reset {
      flex: 0 0 auto;
      min-height: 40px;
      padding: 8px 14px;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: #fff;
      color: var(--blue-dark);
      font-weight: 750;
      cursor: pointer;
    }

    .wbb-main { padding: 18px; }

    .wbb-stage {
      position: relative;
      border: 1px solid #adc6df;
      border-radius: 18px;
      overflow: hidden;
      background: var(--stage);
    }

    .wbb-stage-top {
      position: absolute;
      z-index: 2;
      inset: 12px 13px auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      pointer-events: none;
    }

    .wbb-badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      min-height: 30px;
      padding: 5px 11px;
      border: 1px solid rgba(40, 95, 159, 0.23);
      border-radius: 999px;
      background: rgba(255,255,255,0.93);
      color: var(--navy);
      font-size: 0.78rem;
      font-weight: 800;
      box-shadow: 0 4px 14px rgba(21, 52, 86, 0.08);
    }

    .wbb-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--cyan);
    }

    canvas {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1000 / 340;
    }

    .wbb-prompt-panel {
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin-top: 14px;
      padding: 15px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: #fff;
    }

    .wbb-step-label {
      margin: 0 0 5px;
      color: var(--blue);
      font-size: 0.72rem;
      font-weight: 850;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .wbb-question {
      margin: 0;
      color: var(--navy);
      font-size: 1.02rem;
      font-weight: 800;
      line-height: 1.35;
    }

    .wbb-choices {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 10px;
      margin-top: 11px;
    }

    .wbb-choice {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      padding: 10px 10px 11px;
      border: 1px solid #9eb4cb;
      border-radius: 13px;
      background: #fff;
      color: var(--ink);
      font-weight: 750;
      text-align: center;
      cursor: pointer;
    }

    .wbb-choice canvas {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 200 / 96;
      border-radius: 9px;
      background: var(--stage);
    }

    .wbb-choice-text { font-size: 0.86rem; line-height: 1.3; }


    .wbb-choice:hover:not(:disabled) { border-color: var(--blue); background: var(--blue-soft); }

    .wbb-feedback {
      margin: 10px 0 0;
      padding: 10px 12px;
      border-radius: 11px;
      background: var(--success-soft);
      color: #14532d;
      font-size: 0.88rem;
      font-weight: 650;
      line-height: 1.42;
    }

    .wbb-feedback[data-tone="note"] { background: var(--orange-soft); color: #7c2d12; }

    .wbb-primary {
      width: 100%;
      margin-top: 11px;
      padding: 10px 14px;
      border: 0;
      border-radius: 11px;
      background: var(--blue);
      color: #fff;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 5px 13px rgba(40,95,159,0.22);
    }

    .wbb-primary:hover { background: var(--blue-dark); }
    .wbb-primary:disabled, .wbb-choice:disabled { cursor: not-allowed; opacity: 0.58; }

    [hidden] { display: none !important; }

    :focus-visible { outline: 3px solid #e56b24; outline-offset: 3px; }

    .wbb-sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (max-width: 760px) {
      .wbb-main { padding: 12px; }
    }

    @media (max-width: 480px) {
      .wbb-header { align-items: flex-start; padding: 15px 14px 13px; }
      .wbb-stage-top { align-items: flex-start; }
    }
  </style>
</head>
<body>
  <main class="wbb-app" id="boundary-app">
    <header class="wbb-header">
      <div>
        <p class="wbb-kicker">Unit 5 · Lesson 1 · Part 3</p>
        <h1>Boundary Behavior: Reflect and Transmit</h1>
      </div>
      <button class="wbb-reset" id="reset-button" type="button">Reset</button>
    </header>

    <div class="wbb-main">
      <section class="wbb-stage">
        <div class="wbb-stage-top" aria-hidden="true">
          <span class="wbb-badge"><span class="wbb-dot"></span><span id="left-badge">Light rope</span></span>
          <span class="wbb-badge" id="motion-badge">Ready</span>
        </div>
        <canvas id="rope-canvas" role="img" aria-labelledby="canvas-label"></canvas>
        <p class="wbb-sr-only" id="canvas-label">A pulse travels along a rope toward a boundary on the right, where it may reflect, invert, or continue into a second rope.</p>
      </section>

      <section class="wbb-prompt-panel" aria-labelledby="prompt-question">
        <p class="wbb-step-label" id="step-label">Predict first</p>
        <p class="wbb-question" id="prompt-question">How will the pulse come back?</p>
        <div class="wbb-choices" id="choices"></div>
        <p class="wbb-feedback" id="feedback" role="status" aria-live="polite" hidden></p>
        <button class="wbb-primary" id="main-button" type="button" hidden>Next scenario</button>
      </section>
    </div>

    <p class="wbb-sr-only" id="status" role="status" aria-live="polite">Boundary simulation ready.</p>

    <script>
      (() => {
        'use strict';

        const W = 1000;
        const H = 340;
        const BASE = 190;          // rope equilibrium line
        const XB = 620;            // boundary position
        const X0 = 90;             // pulse start
        const AMP = 62;
        const PULSE_W = 54;
        const TRAIN_L = 132;       // wavelength in the left medium

        const scenarios = [
          {
            id: 'fixed',
            title: 'Fixed end',
            text: 'The far end of the rope is clamped to a wall.',
            end: 'fixed', shape: 'pulse',
            v1: 340, v2: null, label1: 'Rope',
            freeze: 2.7,
            question: 'How will the pulse come back?',
            options: [
              { text: 'Inverted, below the rope', correct: true, preview: { end: 'fixed', r: -1, t: 0 } },
              { text: 'Upright, same side', correct: false, preview: { end: 'fixed', r: 1, t: 0 } },
              { text: 'It will not come back', correct: false, preview: { end: 'fixed', r: 0, t: 0 } }
            ],
            explanation: 'It returns inverted. The clamped point cannot move, so the reflected pulse must cancel the incoming one there.'
          },
          {
            id: 'free',
            title: 'Free end',
            text: 'The end is a ring that slides freely on a smooth pole.',
            end: 'free', shape: 'pulse',
            v1: 340, v2: null, label1: 'Rope',
            freeze: 2.7,
            question: 'How will this pulse come back?',
            options: [
              { text: 'Upright, same side', correct: true, preview: { end: 'free', r: 1, t: 0 } },
              { text: 'Inverted, below the rope', correct: false, preview: { end: 'free', r: -1, t: 0 } },
              { text: 'It will not come back', correct: false, preview: { end: 'free', r: 0, t: 0 } }
            ],
            explanation: 'It returns upright. A free end whips past the incoming height instead of being held down.'
          },
          {
            id: 'light-to-heavy',
            title: 'Light rope into heavy rope',
            text: 'A heavier rope is knotted on at the joint.',
            end: 'boundary', shape: 'pulse',
            v1: 340, v2: 170, label1: 'Light rope', label2: 'Heavy rope',
            freeze: 2.7,
            question: 'What happens at the joint?',
            options: [
              {
                text: 'Part reflects inverted, part keeps going',
                correct: true,
                preview: { end: 'boundary', ratio: 0.5, r: -1 / 3, t: 2 / 3 }
              },
              {
                text: 'Part reflects upright, part keeps going',
                correct: false,
                preview: { end: 'boundary', ratio: 0.5, r: 1 / 3, t: 2 / 3 }
              },
              {
                text: 'All of it keeps going, nothing reflects',
                correct: false,
                preview: { end: 'boundary', ratio: 0.5, r: 0, t: 1 }
              }
            ],
            explanation: 'Part reflects inverted and part transmits. The heavy rope carries its share slower, so that pulse is narrower.'
          },
          {
            id: 'heavy-to-light',
            title: 'Heavy rope into light rope',
            text: 'The same joint, but the pulse now starts in the heavy rope.',
            end: 'boundary', shape: 'pulse',
            v1: 190, v2: 380, label1: 'Heavy rope', label2: 'Light rope',
            freeze: 3.5,
            question: 'How does the reflected pulse come back this time?',
            options: [
              {
                text: 'Upright, same side',
                correct: true,
                preview: { end: 'boundary', ratio: 2, r: 1 / 3, t: 4 / 3 }
              },
              {
                text: 'Inverted, below the rope',
                correct: false,
                preview: { end: 'boundary', ratio: 2, r: -1 / 3, t: 4 / 3 }
              },
              {
                text: 'Nothing reflects here',
                correct: false,
                preview: { end: 'boundary', ratio: 2, r: 0, t: 1 }
              }
            ],
            explanation: 'It returns upright. Inversion happens only at a fixed end or when the wave meets a slower medium.'
          },
          {
            id: 'train',
            title: 'Steady wave into heavy rope',
            text: 'The source now shakes at a steady rate instead of sending one pulse.',
            end: 'boundary', shape: 'train',
            v1: 340, v2: 170, label1: 'Light rope', label2: 'Heavy rope',
            freeze: 5.2,
            question: 'Crossing the joint, which quantity does not change?',
            options: [
              {
                text: 'Frequency stays the same',
                correct: true,
                preview: { kind: 'train', end: 'boundary', ratio: 0.5, lambda2: 22, f2: 0.7 }
              },
              {
                text: 'Wavelength stays the same',
                correct: false,
                preview: { kind: 'train', end: 'boundary', ratio: 0.5, lambda2: 44, f2: 0.35 }
              },
              {
                text: 'Speed stays the same',
                correct: false,
                preview: { kind: 'train', end: 'boundary', ratio: 0.5, lambda2: 44, f2: 0.7 }
              }
            ],
            explanation: 'Frequency stays the same. The joint is shaken at the source rate, so slower speed forces a shorter wavelength.'
          }
        ];

        const el = {
          canvas: document.getElementById('rope-canvas'),
          leftBadge: document.getElementById('left-badge'),
          motionBadge: document.getElementById('motion-badge'),
          stepLabel: document.getElementById('step-label'),
          question: document.getElementById('prompt-question'),
          choices: document.getElementById('choices'),
          feedback: document.getElementById('feedback'),
          main: document.getElementById('main-button'),
          reset: document.getElementById('reset-button'),
          status: document.getElementById('status')
        };

        const ctx = el.canvas.getContext('2d');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let index = 0;
        let state = 'predict';       // predict → reveal → explain
        let simTime = 0;
        let running = false;
        let previousFrame = 0;
        let completionSent = false;
        let pendingCorrect = false;
        let summaryTime = 0;

        function scenario() { return scenarios[index]; }

        function coefficients(s) {
          if (s.end === 'fixed') return { r: -1, t: 0 };
          if (s.end === 'free') return { r: 1, t: 0 };
          return { r: (s.v2 - s.v1) / (s.v2 + s.v1), t: (2 * s.v2) / (s.v1 + s.v2) };
        }

        function shape(u, kind) {
          if (kind === 'train') {
            if (u > 0) return 0;
            return Math.sin(2 * Math.PI * u) * Math.min(1, -u * 1.4);
          }
          return Math.exp(-u * u);
        }

        function ropeY(x, s) {
          const kind = s.shape;
          const length = kind === 'train' ? TRAIN_L : PULSE_W;
          const center = X0 + s.v1 * simTime;
          const { r, t } = coefficients(s);
          if (x <= XB) {
            const incoming = shape((x - center) / length, kind);
            const back = shape(((2 * XB - x) - center) / length, kind);
            return BASE - AMP * (incoming + r * back);
          }
          if (s.v2 == null) return BASE;
          const mapped = XB + (x - XB) * (s.v1 / s.v2);
          return BASE - AMP * t * shape((mapped - center) / length, kind);
        }

        // Render at 2 device pixels per CSS pixel minimum: the rope is one long curved stroke,
        // and on a 1x display the extra samples are what keep the transmitted pulse smooth.
        function pixelRatio() {
          return Math.max(window.devicePixelRatio || 1, 2);
        }

        function fitCanvas() {
          const ratio = pixelRatio();
          const cssWidth = el.canvas.clientWidth || W;
          const cssHeight = cssWidth * (H / W);
          el.canvas.width = Math.round(cssWidth * ratio);
          el.canvas.height = Math.round(cssHeight * ratio);
          ctx.setTransform((cssWidth * ratio) / W, 0, 0, (cssHeight * ratio) / H, 0, 0);
        }

        function drawHatch(x, width, top = 40, bottom = H - 40) {
          const height = bottom - top;
          ctx.save();
          ctx.beginPath();
          ctx.rect(x, top, width, height);
          ctx.clip();
          ctx.fillStyle = '#dfe8f2';
          ctx.fillRect(x, top, width, height);
          ctx.strokeStyle = '#9db4cc';
          ctx.lineWidth = 3;
          for (let i = -height; i < width + height; i += 16) {
            ctx.beginPath();
            ctx.moveTo(x + i, top);
            ctx.lineTo(x + i + height, bottom);
            ctx.stroke();
          }
          ctx.restore();
          ctx.strokeStyle = '#5b7087';
          ctx.lineWidth = 3;
          ctx.strokeRect(x, top, width, height);
        }

        // Hue still carries the medium, so the ropes gain depth from a dark edge and a lit top
        // rather than from a new colour.
        const ROPE_LEFT = { base: '#285f9f', dark: '#123f6d', light: '#8fbdea' };
        const ROPE_RIGHT = { base: '#7a5db5', dark: '#4c3785', light: '#c3ace9' };

        // Draws a laid rope along `points`: shadowed edge, body, twist marks, then a highlight
        // down the upper side. The twist marks sit at fixed positions along the rope because a
        // transverse wave moves the rope up and down, never along its own length.
        function paintRope(context, points, palette, width, twistGap) {
          const trace = () => {
            context.beginPath();
            for (let i = 0; i < points.length; i += 1) {
              if (i === 0) context.moveTo(points[i][0], points[i][1]);
              else context.lineTo(points[i][0], points[i][1]);
            }
          };

          context.save();
          context.lineJoin = 'round';
          context.lineCap = 'round';

          trace();
          context.strokeStyle = palette.dark;
          context.lineWidth = width + Math.max(1.6, width * 0.22);
          context.stroke();

          trace();
          context.strokeStyle = palette.base;
          context.lineWidth = width;
          context.stroke();

          context.lineCap = 'butt';
          context.globalAlpha = 0.36;
          context.strokeStyle = palette.dark;
          context.lineWidth = Math.max(1.4, width * 0.26);
          context.beginPath();
          const reach = width * 0.46;
          for (let i = 2; i < points.length - 2; i += twistGap) {
            const dx = points[i + 2][0] - points[i - 2][0];
            const dy = points[i + 2][1] - points[i - 2][1];
            const len = Math.hypot(dx, dy) || 1;
            // 62° off the tangent: mostly across the rope, raked along it like a laid strand
            const sx = (dx / len) * 0.47 + (dy / len) * 0.88;
            const sy = (dy / len) * 0.47 - (dx / len) * 0.88;
            context.moveTo(points[i][0] - sx * reach, points[i][1] - sy * reach);
            context.lineTo(points[i][0] + sx * reach, points[i][1] + sy * reach);
          }
          context.stroke();

          context.globalAlpha = 0.5;
          context.lineCap = 'round';
          context.strokeStyle = palette.light;
          context.lineWidth = Math.max(1.1, width * 0.2);
          context.beginPath();
          const lift = width * 0.25;
          for (let i = 1; i < points.length - 1; i += 1) {
            const dx = points[i + 1][0] - points[i - 1][0];
            const dy = points[i + 1][1] - points[i - 1][1];
            const len = Math.hypot(dx, dy) || 1;
            const px = points[i][0] + (dy / len) * lift;
            const py = points[i][1] - (dx / len) * lift;
            if (i === 1) context.moveTo(px, py); else context.lineTo(px, py);
          }
          context.stroke();
          context.restore();
        }

        // Sampled every logical pixel. In the slower medium the pulse is compressed toward the
        // joint, so a coarser step showed the transmitted crest as flat facets.
        function drawRopeSegment(from, to, s, palette, width) {
          const points = [];
          for (let x = from; x <= to; x += 1) points.push([x, ropeY(x, s)]);
          paintRope(ctx, points, palette, width, Math.max(10, Math.round(width * 1.7)));
        }

        function draw() {
          const s = scenario();
          ctx.clearRect(0, 0, W, H);

          // medium tints
          ctx.fillStyle = '#f4f9ff';
          ctx.fillRect(0, 0, XB, H);
          if (s.end === 'boundary') {
            ctx.fillStyle = s.v2 < s.v1 ? '#eef0f7' : '#f7fbff';
            ctx.fillRect(XB, 0, W - XB, H);
          }

          // equilibrium line
          ctx.save();
          ctx.setLineDash([7, 9]);
          ctx.strokeStyle = '#b9c8d8';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(20, BASE);
          ctx.lineTo(W - 20, BASE);
          ctx.stroke();
          ctx.restore();

          // support / boundary furniture
          if (s.end === 'fixed') drawHatch(XB, 60);
          if (s.end === 'free') {
            ctx.strokeStyle = '#5b7087';
            ctx.lineWidth = 8;
            ctx.beginPath();
            ctx.moveTo(XB, 52);
            ctx.lineTo(XB, H - 52);
            ctx.stroke();
          }
          if (s.end === 'boundary') {
            ctx.save();
            ctx.setLineDash([6, 7]);
            ctx.strokeStyle = '#8ca7c2';
            ctx.lineWidth = 3;
            ctx.beginPath();
            ctx.moveTo(XB, 40);
            ctx.lineTo(XB, H - 40);
            ctx.stroke();
            ctx.restore();
          }

          // source shaker
          ctx.fillStyle = '#153456';
          ctx.fillRect(14, 96, 18, 148);

          const lightWidth = 7;
          const heavyWidth = 13;
          const leftWidth = s.end === 'boundary' && s.v1 < s.v2 ? heavyWidth : lightWidth;
          const rightWidth = s.end === 'boundary' && s.v2 < s.v1 ? heavyWidth : lightWidth;

          drawRopeSegment(32, XB, s, ROPE_LEFT, leftWidth);
          if (s.end === 'boundary') drawRopeSegment(XB, W - 20, s, ROPE_RIGHT, rightWidth);

          // end hardware
          const endY = ropeY(XB, s);
          if (s.end === 'free') {
            ctx.strokeStyle = '#e56b24';
            ctx.lineWidth = 6;
            ctx.beginPath();
            ctx.arc(XB, endY, 15, 0, Math.PI * 2);
            ctx.stroke();
          } else {
            ctx.fillStyle = s.end === 'fixed' ? '#153456' : '#e56b24';
            ctx.beginPath();
            ctx.arc(XB, endY, 9, 0, Math.PI * 2);
            ctx.fill();
          }

          // labels
          ctx.font = '700 15px system-ui, sans-serif';
          ctx.fillStyle = '#52657b';
          ctx.textAlign = 'left';
          ctx.fillText(s.label1, 40, H - 24);
          if (s.end === 'boundary') {
            ctx.textAlign = 'right';
            ctx.fillText(s.label2, W - 30, H - 24);
          } else {
            drawEndTag(
              s.end === 'fixed' ? 'FIXED END' : 'FREE END',
              s.end === 'fixed' ? XB + 60 : XB + 6,
              BASE - 92,
              XB,
              endY
            );
          }
          ctx.textAlign = 'left';
          ctx.fillStyle = '#153456';
          ctx.font = '800 14px system-ui, sans-serif';
          ctx.fillText('SOURCE', 12, 84);

          // evidence appears only during and after the reveal
          if (state !== 'predict') {
            const { r, t } = coefficients(s);
            const center = X0 + s.v1 * simTime;
            ctx.font = '800 15px system-ui, sans-serif';
            ctx.textAlign = 'center';
            if (s.shape === 'train') {
              if (center > XB + 40) {
                drawLambda(300, TRAIN_L, '#9a3d0d', 'λ');
                drawLambda(XB + 60, TRAIN_L * (s.v2 / s.v1), '#4c3b7a', 'λ');
              }
            } else {
              const backCenter = 2 * XB - center;
              if (center > XB && backCenter > 90 && Math.abs(r) > 0.05) {
                const spot = Math.min(Math.max(backCenter, 130), XB - 110);
                ctx.fillStyle = '#9a3d0d';
                ctx.fillText(r < 0 ? 'reflected · inverted' : 'reflected · upright', spot, r < 0 ? BASE + 116 : BASE - 104);
              }
              if (t > 0.05 && center > XB) {
                const front = XB + (center - XB) * (s.v2 / s.v1);
                ctx.fillStyle = '#4c3b7a';
                ctx.fillText('transmitted', Math.min(front, W - 110), BASE - 104);
              }
            }
          }
          ctx.textAlign = 'left';
        }

        // Names the attachment beside the support and points an arrow back at the rope end,
        // so "fixed" and "free" are read off the diagram instead of a caption.
        function drawEndTag(label, supportRight, midY, anchorX, anchorY) {
          const left = supportRight + 52;
          const height = 32;
          const tipX = anchorX + 15;
          const tipY = anchorY - 15;
          const cpX = left - 46;
          const cpY = midY + 34;
          const angle = Math.atan2(tipY - cpY, tipX - cpX);

          ctx.save();
          ctx.font = '850 16px system-ui, sans-serif';
          const width = ctx.measureText(label).width + 26;
          ctx.lineCap = 'round';
          ctx.lineJoin = 'round';

          // white pass first so the arrow stays legible where it crosses the wall hatching
          [{ paint: 'rgba(255,255,255,0.95)', line: 9 }, { paint: '#9a4a10', line: 3.4 }].forEach((pass) => {
            ctx.strokeStyle = pass.paint;
            ctx.lineWidth = pass.line;
            ctx.beginPath();
            ctx.moveTo(left + 6, midY + 17);
            ctx.quadraticCurveTo(cpX, cpY, tipX, tipY);
            ctx.moveTo(tipX, tipY);
            ctx.lineTo(tipX - 15 * Math.cos(angle - 0.42), tipY - 15 * Math.sin(angle - 0.42));
            ctx.moveTo(tipX, tipY);
            ctx.lineTo(tipX - 15 * Math.cos(angle + 0.42), tipY - 15 * Math.sin(angle + 0.42));
            ctx.stroke();
          });

          const top = midY - height / 2;
          const r = 10;
          ctx.beginPath();
          ctx.moveTo(left + r, top);
          ctx.arcTo(left + width, top, left + width, top + height, r);
          ctx.arcTo(left + width, top + height, left, top + height, r);
          ctx.arcTo(left, top + height, left, top, r);
          ctx.arcTo(left, top, left + width, top, r);
          ctx.closePath();
          ctx.fillStyle = '#fff8f2';
          ctx.fill();
          ctx.strokeStyle = '#e56b24';
          ctx.lineWidth = 2.4;
          ctx.stroke();
          ctx.fillStyle = '#9a4a10';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(label, left + width / 2, midY + 1);
          ctx.restore();
        }

        // ---- closing comparison ----
        // The finished activity hands the stage over to both end conditions at once: two full-width
        // ropes on one clock, so the same incoming pulse comes back inverted above and upright below.
        const SUM_XB = 730;
        const SUM_X0 = 60;
        const SUM_V = 440;
        const SUM_AMP = 46;
        const SUM_LOOP = 3.8;
        const SUM_START = 2.1;     // opens on the return trip, where the two lanes differ

        const summaryLanes = [
          { base: 118, r: -1, end: 'fixed', label: 'FIXED END', note: 'comes back inverted' },
          { base: 252, r: 1, end: 'free', label: 'FREE END', note: 'comes back upright' }
        ];

        function summaryRopeY(x, lane, time) {
          const center = SUM_X0 + SUM_V * time;
          const incoming = Math.exp(-(((x - center) / PULSE_W) ** 2));
          const back = Math.exp(-((((2 * SUM_XB - x) - center) / PULSE_W) ** 2));
          return lane.base - SUM_AMP * (incoming + lane.r * back);
        }

        function drawSummaryStage() {
          const time = summaryTime % SUM_LOOP;
          ctx.clearRect(0, 0, W, H);
          ctx.fillStyle = '#f4f9ff';
          ctx.fillRect(0, 0, W, H);

          summaryLanes.forEach((lane) => {
            ctx.save();
            ctx.setLineDash([7, 9]);
            ctx.strokeStyle = '#b9c8d8';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(20, lane.base);
            ctx.lineTo(SUM_XB, lane.base);
            ctx.stroke();
            ctx.restore();

            if (lane.end === 'fixed') {
              drawHatch(SUM_XB, 46, lane.base - 62, lane.base + 62);
            } else {
              ctx.strokeStyle = '#5b7087';
              ctx.lineWidth = 8;
              ctx.beginPath();
              ctx.moveTo(SUM_XB, lane.base - 62);
              ctx.lineTo(SUM_XB, lane.base + 62);
              ctx.stroke();
            }

            ctx.fillStyle = '#153456';
            ctx.fillRect(14, lane.base - 44, 16, 88);

            const points = [];
            for (let x = 30; x <= SUM_XB; x += 1) points.push([x, summaryRopeY(x, lane, time)]);
            paintRope(ctx, points, ROPE_LEFT, 7, 12);

            const endY = summaryRopeY(SUM_XB, lane, time);
            if (lane.end === 'free') {
              ctx.strokeStyle = '#e56b24';
              ctx.lineWidth = 6;
              ctx.beginPath();
              ctx.arc(SUM_XB, endY, 15, 0, Math.PI * 2);
              ctx.stroke();
            } else {
              ctx.fillStyle = '#153456';
              ctx.beginPath();
              ctx.arc(SUM_XB, endY, 9, 0, Math.PI * 2);
              ctx.fill();
            }

            drawEndTag(
              lane.label,
              lane.end === 'fixed' ? SUM_XB + 46 : SUM_XB + 6,
              lane.base - 46,
              // the free end's ring is wider than the fixed end's knot, so start the arrow clear of it
              SUM_XB + (lane.end === 'free' ? 9 : 0),
              endY
            );

            ctx.font = '700 15px system-ui, sans-serif';
            ctx.fillStyle = '#52657b';
            ctx.textAlign = 'left';
            ctx.fillText(lane.note, SUM_XB + 58, lane.base + 26);
          });
          ctx.textAlign = 'left';
        }

        function drawLambda(x, length, color, label) {
          const y = BASE + 108;
          ctx.strokeStyle = color;
          ctx.fillStyle = color;
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(x, y - 11);
          ctx.lineTo(x, y + 11);
          ctx.moveTo(x + length, y - 11);
          ctx.lineTo(x + length, y + 11);
          ctx.moveTo(x, y);
          ctx.lineTo(x + length, y);
          ctx.stroke();
          ctx.font = '850 16px system-ui, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(label, x + length / 2, y - 16);
        }

        function shuffle(items) {
          const result = items.slice();
          for (let i = result.length - 1; i > 0; i -= 1) {
            const j = Math.floor(Math.random() * (i + 1));
            [result[i], result[j]] = [result[j], result[i]];
          }
          return result;
        }

        // ---- answer previews ----
        // Each choice carries a looping mini-simulation of the outcome it claims, so students
        // compare motions instead of reading three sentences about motion.
        const TW = 200;            // preview coordinate space
        const TH = 96;
        const TBASE = 52;
        const TAMP = 15;
        const TXB = 126;           // boundary inside a preview
        const TX0 = 12;
        const TV = 96;             // preview pulse speed, px per second
        const TPULSE = 17;
        const T_LAMBDA = 44;       // wavelength of the preview wave train
        const T_FREQ = 0.7;
        const TRAIN_STILL = 0.72;  // frozen phase that keeps the train previews distinguishable

        const thumbs = [];
        let thumbClock = 0;

        // How long before the preview is empty again and can restart.
        function previewLoop(cfg) {
          if (cfg.kind === 'train') return 0;
          let end = 1.75;
          if (Math.abs(cfg.r) > 0.05) end = Math.max(end, 3.15);
          if (cfg.t > 0.05 && cfg.ratio) end = Math.max(end, cfg.ratio < 1 ? 3.35 : 1.9);
          return end + 0.3;
        }

        // Single frame used when the viewer asks for reduced motion.
        function previewStill(cfg) {
          if (cfg.kind === 'train') return TRAIN_STILL;
          if (Math.abs(cfg.r) < 0.05 && !cfg.ratio) return 1.2;
          return cfg.ratio > 1 ? 1.45 : 1.95;
        }

        function thumbY(x, cfg, time) {
          if (cfg.kind === 'train') {
            if (x <= TXB) return TBASE - TAMP * Math.sin(2 * Math.PI * ((x - TXB) / T_LAMBDA - T_FREQ * time));
            return TBASE - TAMP * Math.sin(2 * Math.PI * ((x - TXB) / cfg.lambda2 - cfg.f2 * time));
          }
          const center = TX0 + TV * time;
          if (x <= TXB) {
            const incoming = Math.exp(-(((x - center) / TPULSE) ** 2));
            const back = Math.exp(-((((2 * TXB - x) - center) / TPULSE) ** 2));
            return TBASE - TAMP * (incoming + cfg.r * back);
          }
          if (!cfg.ratio) return TBASE;
          const mapped = TXB + (x - TXB) / cfg.ratio;
          return TBASE - TAMP * cfg.t * Math.exp(-(((mapped - center) / TPULSE) ** 2));
        }

        function fitThumb(entry) {
          const ratio = pixelRatio();
          const cssWidth = entry.canvas.clientWidth || TW;
          const cssHeight = cssWidth * (TH / TW);
          entry.canvas.width = Math.round(cssWidth * ratio);
          entry.canvas.height = Math.round(cssHeight * ratio);
          entry.ctx.setTransform((cssWidth * ratio) / TW, 0, 0, (cssHeight * ratio) / TH, 0, 0);
        }

        function strokeThumbRope(entry, from, to, time, palette, width) {
          const points = [];
          for (let x = from; x <= to; x += 0.5) points.push([x, thumbY(x, entry.cfg, time)]);
          // two samples per logical pixel here, so the twist gap counts double
          paintRope(entry.ctx, points, palette, width, Math.max(13, Math.round(width * 3.4)));
        }

        function drawThumb(entry) {
          const { ctx, cfg } = entry;
          const time = reduceMotion ? cfg.still : (cfg.loop ? thumbClock % cfg.loop : thumbClock);

          ctx.clearRect(0, 0, TW, TH);
          ctx.fillStyle = '#f4f9ff';
          ctx.fillRect(0, 0, TW, TH);
          if (cfg.end === 'boundary') {
            ctx.fillStyle = cfg.ratio < 1 ? '#eef0f7' : '#f7fbff';
            ctx.fillRect(TXB, 0, TW - TXB, TH);
          }

          ctx.save();
          ctx.setLineDash([4, 5]);
          ctx.strokeStyle = '#b9c8d8';
          ctx.lineWidth = 1.4;
          ctx.beginPath();
          ctx.moveTo(6, TBASE);
          ctx.lineTo(TW - 6, TBASE);
          ctx.stroke();
          ctx.restore();

          if (cfg.end === 'fixed') {
            ctx.fillStyle = '#dfe8f2';
            ctx.fillRect(TXB, 11, 16, TH - 22);
            ctx.strokeStyle = '#5b7087';
            ctx.lineWidth = 2;
            ctx.strokeRect(TXB, 11, 16, TH - 22);
          } else if (cfg.end === 'free') {
            ctx.strokeStyle = '#5b7087';
            ctx.lineWidth = 4;
            ctx.beginPath();
            ctx.moveTo(TXB, 13);
            ctx.lineTo(TXB, TH - 13);
            ctx.stroke();
          } else {
            ctx.save();
            ctx.setLineDash([4, 5]);
            ctx.strokeStyle = '#8ca7c2';
            ctx.lineWidth = 2;
            ctx.beginPath();
            ctx.moveTo(TXB, 9);
            ctx.lineTo(TXB, TH - 9);
            ctx.stroke();
            ctx.restore();
          }

          const heavyLeft = cfg.end === 'boundary' && cfg.ratio > 1;
          strokeThumbRope(entry, 6, TXB, time, ROPE_LEFT, heavyLeft ? 6 : 3.6);
          if (cfg.end === 'boundary') {
            strokeThumbRope(entry, TXB, TW - 5, time, ROPE_RIGHT, cfg.ratio < 1 ? 6 : 3.6);
          }

          if (cfg.kind !== 'train') {
            const endY = thumbY(TXB, cfg, time);
            if (cfg.end === 'free') {
              ctx.strokeStyle = '#e56b24';
              ctx.lineWidth = 3;
              ctx.beginPath();
              ctx.arc(TXB, endY, 7, 0, Math.PI * 2);
              ctx.stroke();
            } else {
              ctx.fillStyle = cfg.end === 'fixed' ? '#153456' : '#e56b24';
              ctx.beginPath();
              ctx.arc(TXB, endY, 4.5, 0, Math.PI * 2);
              ctx.fill();
            }
          }
        }

        function renderChoices(options, handler) {
          el.choices.replaceChildren();
          thumbs.length = 0;
          thumbClock = 0;
          shuffle(options).forEach((option) => {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'wbb-choice';
            const canvas = document.createElement('canvas');
            canvas.setAttribute('aria-hidden', 'true');
            const caption = document.createElement('span');
            caption.className = 'wbb-choice-text';
            caption.textContent = option.text;
            button.append(canvas, caption);
            button.addEventListener('click', () => handler(option), { once: true });
            el.choices.append(button);

            const cfg = Object.assign({}, option.preview);
            cfg.loop = previewLoop(cfg);
            cfg.still = previewStill(cfg);
            thumbs.push({ canvas, ctx: canvas.getContext('2d'), cfg });
          });
          // Size the previews only once the whole grid exists, so every one measures its final column.
          thumbs.forEach((entry) => { fitThumb(entry); drawThumb(entry); });
        }


        function lockChoices() {
          el.choices.querySelectorAll('button').forEach((button) => { button.disabled = true; });
        }

        function loadScenario() {
          const s = scenario();
          state = 'predict';
          simTime = 0;
          running = false;
          el.leftBadge.textContent = s.title;
          el.motionBadge.textContent = 'Ready';
          el.stepLabel.textContent = `Predict · scenario ${index + 1} of ${scenarios.length}`;
          el.question.textContent = s.question;
          el.feedback.hidden = true;
          el.main.hidden = true;
          el.choices.hidden = false;
          renderChoices(s.options, choose);
          draw();
          el.status.textContent = `${s.title}. ${s.text} Choose a prediction.`;
        }

        function choose(option) {
          if (state !== 'predict') return;
          lockChoices();
          el.choices.hidden = true;
          state = 'reveal';
          el.stepLabel.textContent = 'Watch the boundary';
          el.question.textContent = 'The pulse reaches the boundary.';
          el.motionBadge.textContent = 'Playing';
          simTime = 0;
          running = true;
          el.status.textContent = 'Reveal running.';
          if (reduceMotion) {
            simTime = scenario().freeze;
            finishReveal(option.correct);
          } else {
            pendingCorrect = option.correct;
          }
        }

        function finishReveal(correct) {
          const s = scenario();
          running = false;
          simTime = s.freeze;
          state = 'explain';
          draw();
          el.motionBadge.textContent = 'Frozen';
          el.question.textContent = 'What the rope did:';
          el.feedback.textContent = s.explanation;
          el.feedback.dataset.tone = correct ? 'success' : 'note';
          el.feedback.hidden = false;
          el.main.textContent = index === scenarios.length - 1 ? 'Finish' : 'Next scenario';
          el.main.hidden = false;
          el.stepLabel.textContent = 'Evidence';
          el.status.textContent = s.explanation;
        }

        function handleMain() {
          if (state === 'complete') { index = 0; loadScenario(); return; }
          if (index < scenarios.length - 1) {
            index += 1;
            loadScenario();
            return;
          }
          state = 'complete';
          index = scenarios.length - 1;
          el.stepLabel.textContent = 'All five boundaries done';
          el.question.textContent = 'The two ends, running side by side above.';
          el.feedback.textContent = 'Reflection inverts only at a fixed end or a slower medium. Frequency never changes at the joint.';
          el.feedback.dataset.tone = 'success';
          el.feedback.hidden = false;
          el.leftBadge.textContent = 'Fixed vs free';
          el.motionBadge.textContent = reduceMotion ? 'Frozen' : 'Looping';
          summaryTime = SUM_START;
          drawSummaryStage();
          el.main.textContent = 'Start over';
          sendCompletion();
        }

        function sendCompletion() {
          if (completionSent) return;
          completionSent = true;
          window.parent.postMessage({ type: 'complete' }, '*');
          el.status.textContent = 'Boundary behavior walkthrough complete. The stage now runs both ends together: '
            + 'the fixed end sends the pulse back inverted, the free end sends it back upright.';
        }

        function animate(now) {
          const delta = previousFrame ? Math.min((now - previousFrame) / 1000, 0.05) : 0;
          previousFrame = now;
          if (running) {
            simTime += delta;
            const limit = scenario().freeze;
            if (simTime >= limit) {
              simTime = limit;
              running = false;
              el.motionBadge.textContent = 'Frozen';
              if (state === 'reveal') finishReveal(pendingCorrect);
            }
          }
          if (state === 'predict' && !reduceMotion && thumbs.length) {
            thumbClock += delta;
            thumbs.forEach(drawThumb);
          }
          if (state === 'complete' && !reduceMotion) {
            summaryTime += delta;
            drawSummaryStage();
          }
          // Otherwise the stage only changes while the pulse is running; every other repaint of
          // it is driven by a state change that calls draw() itself.
          if (running) draw();
          requestAnimationFrame(animate);
        }

        function reset() {
          index = 0;
          completionSent = false;
          loadScenario();
        }

        el.main.addEventListener('click', handleMain);
        el.reset.addEventListener('click', reset);
        window.addEventListener('resize', () => {
          fitCanvas();
          if (state === 'complete') drawSummaryStage(); else draw();
          thumbs.forEach((entry) => { fitThumb(entry); drawThumb(entry); });
        });
        document.addEventListener('visibilitychange', () => { if (document.hidden) previousFrame = 0; });

        fitCanvas();
        reset();
        requestAnimationFrame(animate);
      })();
    </script>
  </main>
</body>
</html>
